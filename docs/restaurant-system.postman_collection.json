  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Cadastro de usuario valido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var unique = Date.now();",
                  "pm.collectionVariables.set('emailUsuario', 'maria.' + unique + '@restaurante.com');",
                  "pm.collectionVariables.set('emailUsuarioAtualizado', 'maria.atualizada.' + unique + '@restaurante.com');",
                  "pm.collectionVariables.set('loginUsuario', 'maria.' + unique);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.collectionVariables.set('usuarioId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Oliveira\",\n  \"email\": \"{{emailUsuario}}\",\n  \"login\": \"{{loginUsuario}}\",\n  \"senha\": \"SenhaSegura123\",\n  \"tipoUsuario\": \"DONO_RESTAURANTE\",\n  \"endereco\": {\n    \"rua\": \"Rua das Flores\",\n    \"numero\": \"120\",\n    \"complemento\": \"Sala 2\",\n    \"cidade\": \"Sao Paulo\",\n    \"cep\": \"01001-000\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "usuarios"
              ]
            },
            "description": "Cria um usuario valido e salva o id retornado na variavel de colecao usuarioId."
          },
          "response": []
        },
