  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "emailUsuario",
      "value": ""
    },
    {
      "key": "emailUsuarioAtualizado",
      "value": ""
    },
